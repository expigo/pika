# Production / Staging VPS Environment Variables
# Copy this file to `.env` next to the compose file on the VPS and fill in real values.
# These are interpolated into docker-compose.{prod,staging}.yml via ${VAR}.
# DO NOT commit the actual .env file to git!
#
# NOTE: NEXT_PUBLIC_* (web) are NOT set here — they're baked into the web image at
# build time from GitHub Actions secrets, not read from this file.

# --- Database ---
# openssl rand -base64 32
POSTGRES_PASSWORD=your_secure_password_here

# --- Better Auth (DJ + admin auth authority) — REQUIRED ---
# Signs/verifies session tokens. Without it the cloud will not start (compose uses :? to fail fast).
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Optional override; defaults in compose to the env's API origin
# (prod: https://api.pika.stream, staging: https://staging-api.pika.stream).
# BETTER_AUTH_URL=

# --- Web Push (VAPID) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@pika.stream

# --- Track D (Spotify web-DJ broadcaster) ---
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Optional override; defaults in compose to the env's /api/spotify/callback.
# SPOTIFY_REDIRECT_URI=
# Encrypts stored Spotify refresh tokens at rest. openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# --- Error monitoring (optional) ---
SENTRY_DSN=

# --- Overrides (optional; sane defaults in compose) ---
# WEB_BASE_URL=
# WS_RATE_LIMIT=1000
