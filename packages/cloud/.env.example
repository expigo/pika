# Server Configuration
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# Database
DATABASE_URL=postgres://pika:pika@localhost:5433/pika_cloud

# Security
JWT_SECRET=dev_secret_do_not_use_in_prod
Admin_SECRET=dev_admin_secret

# Push Notifications (Generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@pika.stream

# Rate Limiting
WS_RATE_LIMIT=10

# Spotify integration (Track D — Web DJ Spotify-source broadcaster)
# Register an app at https://developer.spotify.com/dashboard (Dev Mode, owner Premium).
# Redirect URI must match exactly (prod: https://api.pika.stream/api/spotify/callback).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3001/api/spotify/callback
# 32-byte base64 key for encrypting Spotify refresh tokens at rest. Generate with:
#   openssl rand -base64 32
# Treat like DATABASE_URL — rotating it invalidates all stored Spotify connections.
TOKEN_ENCRYPTION_KEY=

# Better Auth (auth foundation) — generate secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://127.0.0.1:3001
# Extra origins Better Auth should trust in DEV (comma-separated) — e.g. a phone on the LAN
# opening a magic link at http://192.168.1.50:3002 (CORS already reflects LAN; this covers
# Better Auth's own origin/callback checks).
BETTER_AUTH_TRUSTED_ORIGINS=

# Transactional email (dancer magic links + account deletion) — Resend (https://resend.com).
# UNSET in dev = magic-link URLs are LOGGED instead of sent (📧 [mail-fallback] lines).
# In production a missing key makes dancer sign-in fail loudly.
# NOTE: onboarding@resend.dev only delivers to the Resend account owner — verify the
# pika.stream domain (DKIM/SPF/MX per the Resend dashboard) before real dancers use this.
RESEND_API_KEY=
MAIL_FROM=Pika! <journal@pika.stream>
# Process-wide daily fuse across ALL transactional mail (sender-reputation/quota protection;
# default 200 — see LIMITS.MAIL_GLOBAL_DAILY_MAX). When it trips, auth emails FAIL LOUDLY until
# the UTC day rolls over or the cap is raised. Size it to your Resend plan around events.
MAIL_DAILY_CAP=
