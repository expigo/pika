{
  "name": "@pika/cloud",
  "version": "0.5.0",
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "NODE_ENV=development bun run db:migrate && NODE_ENV=development bun run --hot src/index.ts",
    "start": "bun run src/index.ts",
    "start:prod": "bun run db:migrate && bun run src/index.ts",
    "test": "bun test",
    "test:integration": "RUN_DB_TESTS=1 bun test src/__tests__/db.integration.test.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed:stages": "bun run scripts/seed-stages.ts"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.7.6",
    "@pika/shared": "workspace:*",
    "@sentry/bun": "^10.36.0",
    "better-auth": "^1.6.20",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.6.0",
    "hono-rate-limiter": "^0.5.3",
    "postgres": "^3.4.0",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "@types/web-push": "^3.6.4",
    "bun-types": "^1.2.0",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.9.3"
  }
}
